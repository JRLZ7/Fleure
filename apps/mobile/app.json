{
  "expo": {
    "name": "Fleure Demo",
    "slug": "fleure-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.fleure.demo",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Connect to the Fleure LED prototype.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.fleure.demo",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Connect to the Fleure LED prototype."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
